{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {"python": "3.14.6", "node": "24.17.0"},
  "steps": {
    "build": {
      "commands": [
        "...",
        "/app/.venv/bin/python -m pip install -r requirements.lock.txt",
        "npm --prefix frontend ci",
        "npm --prefix frontend run build",
        "test -f frontend/dist/index.html"
      ]
    }
  },
  "deploy": {
    "startCommand": "python -m uvicorn backend.main:app --host 0.0.0.0 --port $PORT --workers 1 --proxy-headers --forwarded-allow-ips '*' --no-access-log"
  }
}
